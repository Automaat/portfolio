---
const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/motion', label: 'Motion' },
  { href: '/blog', label: 'Journal' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const socialLinks = [
  { href: 'https://www.instagram.com/marcinskalski_photo/', label: 'Instagram', icon: 'instagram' },
  { href: 'https://www.youtube.com/@marcinskalski2201', label: 'YouTube', icon: 'youtube' },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 w-full z-50 transition-transform duration-500 ease-editorial"
>
  <div class="bg-[color:var(--bg)]/85 backdrop-blur-md border-b rule-line">
    <nav class="container-custom py-4 flex items-center justify-between gap-6">
      <a
        href="/"
        class="logo font-mono text-[11px] font-semibold tracking-[0.18em] uppercase text-[color:var(--text)]"
      >
        marcin skalski
      </a>

      <button
        id="mobile-menu-toggle"
        class="desktop:hidden flex flex-col gap-1 w-11 h-11 justify-center items-center p-2 rounded hover:opacity-70 focus:outline-none"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span class="w-6 h-px bg-[color:var(--text)] transition-all"></span>
        <span class="w-6 h-px bg-[color:var(--text)] transition-all"></span>
        <span class="w-6 h-px bg-[color:var(--text)] transition-all"></span>
      </button>

      <div
        id="mobile-menu"
        class="hidden desktop:flex desktop:items-center desktop:gap-10 absolute desktop:relative top-full left-0 w-full desktop:w-auto bg-[color:var(--bg)] desktop:bg-transparent p-6 desktop:p-0 border-b rule-line desktop:border-0"
      >
        <ul
          class="flex flex-col desktop:flex-row gap-6 desktop:gap-8 text-[12px] tracking-[0.14em] uppercase font-mono"
        >
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[color:var(--text)] hover:opacity-70 transition-opacity"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="flex items-center gap-5 mt-6 desktop:mt-0">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[color:var(--text)] hover:opacity-70 transition-opacity"
                aria-label={link.label}
              >
                {link.icon === 'instagram' ? (
                  <svg
                    class="w-[18px] h-[18px]"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                  </svg>
                ) : (
                  <svg
                    class="w-[18px] h-[18px]"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                  </svg>
                )}
              </a>
            ))
          }

          <button
            id="theme-toggle"
            type="button"
            class="text-[color:var(--text)] hover:opacity-70 transition-opacity"
            aria-label="Toggle dark mode"
          >
            <svg
              class="w-[18px] h-[18px] block dark:hidden"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.752 15.002A9.718 9.718 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
              ></path>
            </svg>
            <svg
              class="w-[18px] h-[18px] hidden dark:block"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
              ></path>
            </svg>
          </button>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
  });

  document.addEventListener('click', (e) => {
    if (!toggle?.contains(e.target as Node) && !menu?.contains(e.target as Node)) {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.focus();
    }
  });

  // Hide-on-scroll header
  const header = document.getElementById('site-header');
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      const goingDown = y > lastY;
      if (y > 80 && goingDown) {
        header.style.transform = 'translateY(-100%)';
      } else {
        header.style.transform = '';
      }
      lastY = y;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
  }

  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.classList.toggle('dark') ? 'dark' : 'light';
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* ignore storage errors */
    }
  });
</script>
