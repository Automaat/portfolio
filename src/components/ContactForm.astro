---
// ContactForm.astro - Contact form with Netlify Forms integration
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);

const projectTypes = [
  { value: 'adventure-campaign', label: t('form.type.adventure') },
  { value: 'destination-tourism', label: t('form.type.tourism') },
  { value: 'marine-sailing', label: t('form.type.marine') },
  { value: 'motion-only', label: t('form.type.motion') },
  { value: 'hybrid-photo-video', label: t('form.type.hybrid') },
  { value: 'other', label: t('form.type.other') },
];

const budgets = [
  { value: 'under-3k', label: t('form.budget.under3k') },
  { value: '3k-7k', label: t('form.budget.3k7k') },
  { value: '7k-15k', label: t('form.budget.7k15k') },
  { value: '15k-plus', label: t('form.budget.15kPlus') },
];
---

<form
  name="contact"
  method="POST"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  class="contact-form"
  data-msg-success={t('form.success')}
  data-msg-error={t('form.error')}
  data-msg-sending={t('form.sending')}
  data-msg-submit={t('form.submit')}
>
  <input type="hidden" name="form-name" value="contact" />

  <!-- Honeypot field for spam protection -->
  <p class="hidden">
    <label>
      Don't fill this out if you're human: <input name="bot-field" />
    </label>
  </p>

  <div class="form-group">
    <label for="name" class="form-label">{t('form.name')}</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      class="form-input"
      placeholder={t('form.namePlaceholder')}
    />
  </div>

  <div class="form-group">
    <label for="email" class="form-label">{t('form.email')}</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="form-input"
      placeholder={t('form.emailPlaceholder')}
    />
  </div>

  <div class="form-grid">
    <div class="form-group">
      <label for="project-type" class="form-label">{t('form.projectType')}</label>
      <select id="project-type" name="projectType" required class="form-input form-select">
        <option value="">{t('form.projectTypePlaceholder')}</option>
        {projectTypes.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
    </div>

    <div class="form-group">
      <label for="budget" class="form-label">{t('form.budget')}</label>
      <select id="budget" name="budget" required class="form-input form-select">
        <option value="">{t('form.budgetPlaceholder')}</option>
        {budgets.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
    </div>
  </div>

  <div class="form-grid">
    <div class="form-group">
      <label for="location" class="form-label">{t('form.location')}</label>
      <input
        type="text"
        id="location"
        name="location"
        required
        class="form-input"
        placeholder={t('form.locationPlaceholder')}
      />
    </div>

    <div class="form-group">
      <label for="timeline" class="form-label">{t('form.timeline')}</label>
      <input
        type="text"
        id="timeline"
        name="timeline"
        required
        class="form-input"
        placeholder={t('form.timelinePlaceholder')}
      />
    </div>
  </div>

  <div class="form-group">
    <label for="deliverables" class="form-label">{t('form.deliverables')}</label>
    <textarea
      id="deliverables"
      name="deliverables"
      required
      rows="4"
      class="form-input form-textarea"
      placeholder={t('form.deliverablesPlaceholder')}></textarea>
  </div>

  <div class="form-group">
    <label for="message" class="form-label">{t('form.message')}</label>
    <textarea
      id="message"
      name="message"
      required
      rows="6"
      class="form-input form-textarea"
      placeholder={t('form.messagePlaceholder')}></textarea>
  </div>

  <button type="submit" class="form-submit">{t('form.submit')}</button>

  <div class="form-message" id="form-message"></div>
</form>

<style>
  .contact-form {
    max-width: 600px;
  }

  .hidden {
    display: none;
  }

  .form-group {
    margin-bottom: 2rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 2.5rem;
  }

  .form-label {
    display: block;
    margin-bottom: 0.65rem;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--text-muted);
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 0;
    font-size: 0.9375rem;
    font-family: inherit;
    color: var(--text);
    border: none;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    background: transparent;
    transition: border-color 0.25s ease;
  }

  .form-input::placeholder {
    color: var(--text-subtle);
  }

  .form-input:focus {
    outline: none;
    border-bottom-color: var(--text);
  }

  .form-textarea {
    resize: vertical;
    min-height: 110px;
    line-height: 1.6;
  }

  .form-select {
    appearance: none;
    cursor: pointer;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--text-muted) 50%),
      linear-gradient(135deg, var(--text-muted) 50%, transparent 50%);
    background-position:
      calc(100% - 14px) 50%,
      calc(100% - 8px) 50%;
    background-size:
      6px 6px,
      6px 6px;
    background-repeat: no-repeat;
  }

  .form-select option {
    background: var(--bg);
    color: var(--text);
  }

  .form-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2.75rem;
    font-size: 11px;
    font-weight: 600;
    font-family: inherit;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--bg);
    background: var(--text);
    border: none;
    border-radius: 0;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .form-submit:hover {
    opacity: 0.85;
  }

  .form-submit:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  .form-message {
    margin-top: 1.5rem;
    padding: 1rem 0;
    font-size: 0.9375rem;
    display: none;
  }

  .form-message.success {
    display: block;
    color: var(--text);
    border-top: 1px solid var(--rule);
  }

  .form-message.error {
    display: block;
    color: #c0564f;
    border-top: 1px solid #c0564f;
  }

  @media (max-width: 736px) {
    .form-input {
      font-size: 1rem; /* Prevent zoom on iOS */
    }
  }

  @media (min-width: 737px) {
    .form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  // Client-side form validation and submission handling
  const form = document.querySelector('.contact-form') as HTMLFormElement;
  const messageDiv = document.getElementById('form-message') as HTMLDivElement;

  if (form) {
    const msg = {
      success: form.dataset.msgSuccess ?? 'Thank you! Your message has been sent successfully.',
      error: form.dataset.msgError ?? 'Sorry, there was an error sending your message.',
      sending: form.dataset.msgSending ?? 'Sending...',
      submit: form.dataset.msgSubmit ?? 'Send Message',
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const submitButton = form.querySelector('.form-submit') as HTMLButtonElement;

      // Disable submit button during submission
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = msg.sending;
      }

      try {
        const encodedData = new URLSearchParams(
          Array.from(formData.entries()).map(([key, value]) => [key, String(value)])
        ).toString();

        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: encodedData,
        });

        if (response.ok) {
          messageDiv.textContent = msg.success;
          messageDiv.className = 'form-message success';
          form.reset();
        } else {
          throw new Error('Form submission failed');
        }
      } catch {
        messageDiv.textContent = msg.error;
        messageDiv.className = 'form-message error';
      } finally {
        // Re-enable submit button
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = msg.submit;
        }
      }
    });
  }
</script>
