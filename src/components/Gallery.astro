---
import { Image } from 'astro:assets';

interface Props {
  images: string[];
  alt?: string;
}

const { images, alt = 'Gallery image' } = Astro.props;
---

<div class="gallery">
  {
    images.map((image, index) => (
      <div class="gallery-item">
        <img src={image} alt={`${alt} ${index + 1}`} loading="lazy" class="gallery-image" />
      </div>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin: 4rem 0;
  }

  @media (min-width: 737px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  @media (min-width: 1025px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .gallery-item {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #f5f5f5;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover .gallery-image {
    transform: scale(1.05);
  }
</style>
