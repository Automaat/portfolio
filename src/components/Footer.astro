---
const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/motion', label: 'Motion' },
  { href: '/blog', label: 'Journal' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentYear = new Date().getFullYear();

const socialLinks = [
  { href: 'https://www.instagram.com/marcinskalski_photo/', label: 'Instagram' },
  { href: 'https://www.youtube.com/@marcinskalski2201', label: 'YouTube' },
];
---

<footer class="surface border-t rule-line mt-0">
  <div class="container-custom py-16 desktop:py-20">
    <div class="grid gap-10 desktop:grid-cols-[1.4fr_1fr_1fr] desktop:gap-16">
      <div>
        <p class="font-display text-3xl leading-tight">Marcin Skalski</p>
        <p class="mt-3 text-sm text-muted max-w-xs">
          Adventure, travel, and marine photographer. Europe-based, available worldwide.
        </p>
        <a
          href="mailto:marcin@skalski.com"
          class="mt-6 inline-block text-sm underline underline-offset-8 hover:opacity-70 transition-opacity"
        >
          marcin@skalski.com
        </a>
      </div>

      <div>
        <p class="eyebrow mb-5">Site</p>
        <ul class="space-y-3 text-sm">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="hover:opacity-70 transition-opacity">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="eyebrow mb-5">Social</p>
        <ul class="space-y-3 text-sm">
          {
            socialLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:opacity-70 transition-opacity"
                  aria-label={link.label}
                >
                  {link.label} ↗
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-16 pt-6 border-t rule-line flex flex-col tablet:flex-row gap-3 tablet:items-center tablet:justify-between text-xs text-subtle"
    >
      <p>&copy; {currentYear} Marcin Skalski. All rights reserved.</p>
      <p>Europe-based · Available worldwide</p>
    </div>
  </div>
</footer>
