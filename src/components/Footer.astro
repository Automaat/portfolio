---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();

const links = [
  { href: 'mailto:marcin@skalski.com', label: t('footer.email'), external: false },
  {
    href: 'https://www.instagram.com/marcinskalski_photo/',
    label: 'Instagram ↗',
    external: true,
  },
  { href: 'https://www.youtube.com/@marcinskalski2201', label: 'YouTube ↗', external: true },
];
---

<footer class="surface border-t rule-line">
  <div
    class="container-custom py-10 flex flex-col gap-5 tablet:flex-row tablet:items-baseline tablet:justify-between"
  >
    <p class="text-xs text-subtle">&copy; {currentYear} Marcin Skalski</p>

    <div class="flex flex-wrap gap-x-7 gap-y-3 font-mono text-[11px] uppercase tracking-[0.14em]">
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="hover:opacity-70 transition-opacity"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
