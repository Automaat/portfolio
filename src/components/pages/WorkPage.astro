---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContactBand from '../ContactBand.astro';
import { entrySlug, localePath, tripTime, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = {
  en: {
    title: 'Work | Marcin Skalski',
    description:
      'Adventure, travel, and marine work built for commercial buyers, tourism brands, and expedition operators.',
    eyebrow: 'Work',
    heading: 'Stills and motion from expedition, destination, and marine environments.',
    intro:
      'A working library shaped for commercial briefs — tourism, marine, outdoor, and editorial. Each project is a self-initiated field study with usable deliverables.',
    openCase: 'Open case',
    band: 'Have a brief that fits this work?',
  },
  pl: {
    title: 'Prace | Marcin Skalski',
    description:
      'Fotografia przygodowa, podróżnicza i morska — dla marek turystycznych, operatorów ekspedycji i firm outdoorowych.',
    eyebrow: 'Prace',
    heading: 'Zdjęcia i wideo z ekspedycji, destynacji i środowisk morskich.',
    intro:
      'Robocza biblioteka budowana pod komercyjne briefy — turystyka, morze, outdoor i edytorial. Każdy projekt to samodzielnie zainicjowane studium terenowe z gotowymi materiałami.',
    openCase: 'Zobacz case',
    band: 'Masz brief, który pasuje do tych prac?',
  },
}[locale];

const trips = await getCollection('trips', ({ id }) => id.startsWith(`${locale}/`));
const projects = trips.sort((a, b) => tripTime(b.data.date) - tripTime(a.data.date));
---

<Layout title={copy.title} description={copy.description} locale={locale}>
  <section class="surface">
    <div class="container-custom pt-20 pb-10 desktop:pt-28 desktop:pb-16 border-b rule-line">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 class="mt-4 font-display text-[clamp(2.5rem,7vw,6rem)] leading-[1] max-w-5xl" data-reveal>
        {copy.heading}
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted" data-reveal data-reveal-delay="120">
        {copy.intro}
      </p>
    </div>
  </section>

  <section class="surface">
    <div class="container-custom py-12 desktop:py-20">
      <div class="grid gap-y-16 desktop:gap-y-28">
        {
          projects.map((trip, i) => {
            const isReversed = i % 2 === 1;
            return (
              <a
                href={localePath(locale, `/trips/${entrySlug(trip.id)}`)}
                class="project-row group"
                data-reveal
                data-reveal-delay={`${i * 80}`}
              >
                <div
                  class:list={[
                    'project-grid grid gap-8 desktop:gap-16 items-end',
                    isReversed ? 'project-grid--reverse' : '',
                  ]}
                >
                  <div class="project-image-wrap">
                    <div class="project-image">
                      <img
                        src={trip.data.thumbnail}
                        alt={trip.data.title}
                        loading={i < 2 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </div>
                  </div>

                  <div class="project-meta">
                    <p class="eyebrow">
                      {trip.data.format} · {trip.data.date}
                    </p>
                    <h2 class="mt-4 font-display text-[clamp(2rem,4vw,3.75rem)] leading-[1.02]">
                      {trip.data.title}
                    </h2>
                    <p class="mt-3 text-sm uppercase tracking-[0.18em] text-subtle">
                      {trip.data.location}
                    </p>
                    <p class="mt-6 text-base text-muted max-w-md leading-relaxed">
                      {trip.data.description}
                    </p>

                    <span class="mt-7 inline-flex items-center gap-2 text-[11px] uppercase font-mono tracking-[0.14em] underline underline-offset-8 group-hover:opacity-70 transition-opacity">
                      {copy.openCase} <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <ContactBand label={copy.band} locale={locale} />
</Layout>

<style>
  .project-grid {
    grid-template-columns: 1fr;
  }

  @media (min-width: 1025px) {
    .project-grid {
      grid-template-columns: 1.2fr 0.8fr;
    }
    .project-grid--reverse {
      grid-template-columns: 0.8fr 1.2fr;
    }
    .project-grid--reverse .project-image-wrap {
      order: 2;
    }
    .project-grid--reverse .project-meta {
      order: 1;
    }
  }

  .project-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-elevated);
  }

  @media (min-width: 1025px) {
    .project-image {
      aspect-ratio: 5 / 4;
    }
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .project-row:hover .project-image img {
    transform: scale(1.04);
  }
</style>
