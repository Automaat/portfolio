---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { entrySlug, localePath, tripTime, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = {
  en: {
    title: 'Marcin Skalski | Adventure, Travel & Marine Photographer',
    description:
      'Adventure, travel, and marine photographer plus filmmaker for tourism brands, expeditions, and outdoor companies.',
    fields: 'Adventure · Travel · Marine',
    scrollCue: 'Selected work ↓',
    reach: 'Europe — Worldwide',
    selectedWork: 'Selected work',
    years: '2022–2024',
    showreelTitle: 'Showreel — Motion',
    showreelMeta: 'Selected motion work · 2022–24',
    streetTitle: 'Street',
    streetMeta: 'Personal work · 2022–25',
    newProjects: 'New projects',
    contactLine:
      'Europe-based, available worldwide. Send location, timing, and deliverables — I’ll reply with fit and next step.',
    breakAlt: 'Sailboat on calm open water at dusk',
  },
  pl: {
    title: 'Marcin Skalski | Fotografia przygodowa, podróżnicza i morska',
    description:
      'Fotograf i filmowiec — przygoda, podróże i morze. Dla marek turystycznych, ekspedycji i firm outdoorowych.',
    fields: 'Przygoda · Podróż · Morze',
    scrollCue: 'Wybrane prace ↓',
    reach: 'Europa — cały świat',
    selectedWork: 'Wybrane prace',
    years: '2022–2024',
    showreelTitle: 'Showreel — wideo',
    showreelMeta: 'Wybrane prace wideo · 2022–24',
    streetTitle: 'Street',
    streetMeta: 'Praca własna · 2022–25',
    newProjects: 'Nowe projekty',
    contactLine:
      'Baza w Europie, dostępność na całym świecie. Wyślij lokalizację, terminy i zakres materiałów — odpowiem, czy to dobry fit i co dalej.',
    breakAlt: 'Żaglówka na spokojnej wodzie o zmierzchu',
  },
}[locale];

const trips = (await getCollection('trips', ({ id }) => id.startsWith(`${locale}/`))).sort(
  (a, b) => tripTime(b.data.date) - tripTime(a.data.date)
);

const tiles = trips.map((trip, i) => ({
  href: localePath(locale, `/trips/${entrySlug(trip.id)}`),
  image: trip.data.thumbnail,
  title: trip.data.title,
  meta: `${trip.data.location} · ${trip.data.date}`,
  index: String(i + 1).padStart(2, '0'),
}));

const rows = [
  ...tiles,
  {
    href: localePath(locale, '/motion'),
    image: '/images/hero-sailing.jpg',
    title: copy.showreelTitle,
    meta: copy.showreelMeta,
    index: String(tiles.length + 1).padStart(2, '0'),
  },
  {
    href: localePath(locale, '/street'),
    image: '/images/street/street-02.jpg',
    title: copy.streetTitle,
    meta: copy.streetMeta,
    index: String(tiles.length + 2).padStart(2, '0'),
  },
].map((row) => ({ ...row, year: row.meta.match(/\d{4}(–\d{2,4})?/)?.[0] ?? '' }));
---

<Layout title={copy.title} description={copy.description} headerLogo={false} locale={locale}>
  <section
    class="container-custom pt-10 desktop:pt-16 pb-8 flex flex-col justify-center desktop:justify-between min-h-[calc(100svh-4rem)] desktop:min-h-[calc(100svh-5rem)]"
  >
    <h1 class="masthead font-display uppercase">
      <span class="masthead-l1 block">Marcin</span>
      <span class="masthead-l2 block italic"
        >Skalski<span class="masthead-dot text-[color:var(--accent)]">.</span></span
      >
    </h1>
    <div class="mt-10 flex flex-wrap justify-between gap-3">
      <p class="eyebrow">{copy.fields}</p>
      <p class="eyebrow hidden tablet:block">{copy.scrollCue}</p>
      <p class="eyebrow">{copy.reach}</p>
    </div>
  </section>

  <section class="container-custom mt-6 desktop:mt-10">
    <div class="mb-14 desktop:mb-20 flex items-baseline justify-between">
      <p class="eyebrow">{copy.selectedWork}</p>
      <p class="eyebrow">{copy.years}</p>
    </div>

    <div class="border-t border-[color:var(--text)]">
      {
        rows.map((row) => (
          <a class="row group" href={row.href} data-image={row.image} data-reveal>
            <span class="label-mono text-muted">{row.index}</span>
            <span class="row-title font-display">{row.title}</span>
            <span class="label-mono text-muted hidden tablet:block">
              {row.meta.replace(/\s*·\s*[^·]*$/, '')}
            </span>
            <span class="label-mono text-muted text-right">{row.year}</span>
          </a>
        ))
      }
    </div>
  </section>

  <div id="preview" aria-hidden="true">
    <img src={rows[0]?.image} alt="" />
  </div>

  <section class="mt-[12vh] h-[72vh]">
    <img
      src="/images/hero-sailing.jpg"
      alt={copy.breakAlt}
      class="h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </section>

  <section class="container-custom py-[12vh]">
    <p class="eyebrow" data-reveal>{copy.newProjects}</p>
    <a
      href="mailto:marcin@skalski.com"
      class="contact-mail mt-6 inline-block font-display leading-none"
      data-reveal
      data-reveal-delay="80"
    >
      marcin@skalski.com
    </a>
    <p class="mt-8 max-w-md text-muted" data-reveal data-reveal-delay="140">
      {copy.contactLine}
    </p>
  </section>
</Layout>

<script>
  const preview = document.getElementById('preview') as HTMLDivElement | null;
  const img = preview?.querySelector('img');
  const fine = window.matchMedia('(pointer: fine)').matches;

  if (preview && img && fine) {
    let x = 0,
      y = 0,
      tx = 0,
      ty = 0,
      visible = false;

    document.querySelectorAll<HTMLAnchorElement>('.row').forEach((row) => {
      row.addEventListener('mouseenter', () => {
        img.src = row.dataset.image ?? '';
        visible = true;
        preview.classList.add('on');
      });
      row.addEventListener('mouseleave', () => {
        visible = false;
        preview.classList.remove('on');
      });
    });

    document.addEventListener('mousemove', (e) => {
      tx = e.clientX;
      ty = e.clientY;
    });

    const tick = () => {
      x += (tx - x) * 0.12;
      y += (ty - y) * 0.12;
      if (visible) preview.style.transform = `translate(${x + 24}px, ${y - 140}px)`;
      requestAnimationFrame(tick);
    };
    tick();
  }
</script>

<style>
  .masthead {
    container-type: inline-size;
    line-height: 0.8;
    letter-spacing: -0.025em;
    font-weight: 480;
    font-optical-sizing: auto;
  }

  .masthead-l1,
  .masthead-l2 {
    white-space: nowrap;
  }

  .masthead-l1 {
    font-size: 24vw;
    font-size: 27.2cqw;
  }

  .masthead-l2 {
    font-size: 22vw;
    font-size: 25cqw;
    font-weight: 380;
    margin-top: 0.02em;
  }

  .masthead-dot {
    font-style: normal;
    font-size: 0.72em;
    line-height: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 3rem 1fr 5rem;
    align-items: baseline;
    gap: 2rem;
    padding: 2.1rem 0;
    border-bottom: 1px solid var(--rule);
    transition: padding-left 0.45s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  @media (min-width: 737px) {
    .row {
      grid-template-columns: 3rem 1fr auto 5rem;
    }
  }

  .row:last-child {
    border-bottom-color: var(--text);
  }

  .row:hover {
    padding-left: 1.5rem;
    opacity: 1;
  }

  .row-title {
    font-size: clamp(1.7rem, 3.6vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  #preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 26rem;
    aspect-ratio: 4 / 3;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 40;
    overflow: hidden;
  }

  #preview.on {
    opacity: 1;
  }

  #preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 736px) {
    #preview {
      display: none;
    }
  }

  .contact-mail {
    font-size: clamp(1.9rem, 6.5vw, 6.5rem);
    letter-spacing: -0.02em;
  }

  .contact-mail:hover {
    font-style: italic;
    opacity: 1;
  }
</style>
