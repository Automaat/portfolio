---
interface Props {
  image: string;
  imageWebp?: string;
  imageMobile?: string;
  imageMobileWebp?: string;
  alt: string;
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  align?: 'center' | 'bottom-left' | 'bottom-center';
  minHeight?: string;
  overlay?: 'soft' | 'dark' | 'none';
}

const {
  image,
  imageWebp,
  imageMobile,
  imageMobileWebp,
  alt,
  eyebrow,
  title,
  subtitle,
  align = 'center',
  minHeight = 'min-h-screen',
  overlay = 'soft',
} = Astro.props;

const hasResponsive = imageMobile || imageMobileWebp || imageWebp;
const hasContent = eyebrow || title || subtitle || Astro.slots.has('cta');

const overlayClass = {
  soft: 'bg-[linear-gradient(180deg,rgba(0,0,0,0.18)_0%,rgba(0,0,0,0.55)_60%,rgba(0,0,0,0.82)_100%)]',
  dark: 'bg-[linear-gradient(180deg,rgba(0,0,0,0.4)_0%,rgba(0,0,0,0.7)_100%)]',
  none: '',
}[overlay];

const layoutClass = {
  center: 'items-center justify-center text-center',
  'bottom-left': 'items-end justify-start text-left',
  'bottom-center': 'items-end justify-center text-center',
}[align];

const contentMaxWidth = align === 'center' ? 'max-w-3xl' : 'max-w-5xl';
---

<section class:list={['relative isolate overflow-hidden bg-black text-white', minHeight]}>
  <picture class="absolute inset-0">
    {
      imageMobileWebp && (
        <source media="(max-width: 768px)" srcset={imageMobileWebp} type="image/webp" />
      )
    }
    {imageMobile && <source media="(max-width: 768px)" srcset={imageMobile} />}
    {imageWebp && <source srcset={imageWebp} type="image/webp" />}
    <img
      src={image}
      alt={alt}
      width="2400"
      height="1350"
      class="h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  {overlay !== 'none' && <div class:list={['absolute inset-0', overlayClass]} />}

  {
    hasContent && (
      <div
        class:list={[
          'container-custom relative flex',
          minHeight,
          layoutClass,
          'py-24 desktop:py-32',
        ]}
      >
        <div class={contentMaxWidth}>
          {eyebrow && (
            <p class="mb-5 text-[11px] font-medium uppercase font-mono tracking-[0.18em] text-white/70">
              {eyebrow}
            </p>
          )}
          {title && (
            <h1 class="font-display font-medium leading-[0.95] text-white text-[clamp(2.75rem,8vw,7rem)]">
              {title}
            </h1>
          )}
          {subtitle && (
            <p class="mt-6 max-w-2xl text-base leading-7 text-white/85 desktop:text-lg">
              {subtitle}
            </p>
          )}
          <slot name="cta" />
        </div>
      </div>
    )
  }
  {!hasResponsive && null}
</section>
