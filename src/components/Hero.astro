---
interface Props {
  image: string;
  imageWebp?: string;
  imageMobile?: string;
  imageMobileWebp?: string;
  alt: string;
  title?: string;
  subtitle?: string;
}

const { image, imageWebp, imageMobile, imageMobileWebp, alt, title, subtitle } = Astro.props;

// Determine if we should use responsive picture element
const useResponsive = imageMobile || imageMobileWebp || imageWebp;
---

<section class="hero">
  <div class="hero-image">
    {
      useResponsive ? (
        <picture>
          {/* Mobile WebP */}
          {imageMobileWebp && (
            <source media="(max-width: 768px)" srcset={imageMobileWebp} type="image/webp" />
          )}

          {/* Mobile JPEG fallback */}
          {imageMobile && <source media="(max-width: 768px)" srcset={imageMobile} />}

          {/* Desktop WebP */}
          {imageWebp && <source srcset={imageWebp} type="image/webp" />}

          {/* Desktop JPEG fallback */}
          <img src={image} alt={alt} loading="eager" />
        </picture>
      ) : (
        <img src={image} alt={alt} loading="eager" />
      )
    }
  </div>
  {
    (title || subtitle) && (
      <div class="hero-content">
        {title && <h1 class="hero-title">{title}</h1>}
        {subtitle && <p class="hero-subtitle">{subtitle}</p>}
      </div>
    )
  }
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-image picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-image img,
  .hero-image picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 6vw;
    text-align: center;
    color: white;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.4));
  }

  .hero-title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.5rem);
    font-weight: 400;
    line-height: 1.4;
    margin-top: 1rem;
    max-width: 600px;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);
  }

  @media (min-width: 1025px) {
    .hero-content {
      padding: 4vw;
    }
  }
</style>
