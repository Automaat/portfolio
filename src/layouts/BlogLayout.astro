---
import Layout from './Layout.astro';

interface Props {
  title: string;
  date: string;
  description: string;
  image: string;
}

const { title, date, description, image } = Astro.props;

// Format date for display
const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<Layout title={title} description={description} image={image}>
  <!-- Hero Section -->
  <div class="relative w-full h-[60vh] md:h-[70vh] overflow-hidden">
    <img
      src={image}
      alt={title}
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>

    <div class="absolute bottom-0 left-0 right-0 p-6 md:p-12 text-white">
      <div class="max-w-4xl mx-auto">
        <a
          href="/blog"
          class="inline-block text-sm mb-4 hover:underline text-white/80 hover:text-white transition-colors"
        >
          ← Back to Blog
        </a>
        <h1 class="text-4xl md:text-5xl font-bold mb-2 leading-tight">{title}</h1>
        <p class="text-lg text-white/90">{formatDate(date)}</p>
      </div>
    </div>
  </div>

  <!-- Content Section -->
  <article class="max-w-3xl mx-auto px-6 md:px-12 py-12 md:py-16">
    <div class="prose prose-lg max-w-none">
      <slot />
    </div>
  </article>

  <!-- Back to Blog Link -->
  <div class="max-w-3xl mx-auto px-6 md:px-12 pb-16">
    <a
      href="/blog"
      class="inline-block text-accent hover:underline transition-colors"
    >
      ← Back to Blog
    </a>
  </div>
</Layout>

<style>
  .prose {
    color: #000000;
    line-height: 1.7;
  }

  .prose h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .prose h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .prose p {
    margin-bottom: 1.25rem;
    font-size: 1.0625rem;
  }

  .prose ul, .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose strong {
    font-weight: 700;
  }

  .prose em {
    font-style: italic;
    color: #666;
  }

  .prose a {
    color: #4d6198;
    text-decoration: underline;
  }

  .prose a:hover {
    color: #32373c;
  }
</style>
