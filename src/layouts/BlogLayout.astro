---
import Layout from './Layout.astro';
import Hero from '../components/Hero.astro';
import { formatDate, localePath, useTranslations, type Locale } from '../i18n';

interface Props {
  title: string;
  date: string;
  description: string;
  image: string;
  locale?: Locale;
}

const { title, date, description, image, locale = 'en' } = Astro.props;
const t = useTranslations(locale);
---

<Layout title={title} description={description} image={image} locale={locale}>
  <div class="-mt-16 desktop:-mt-20">
    <Hero
      image={image}
      alt={title}
      eyebrow={`${t('blog.journal')} · ${formatDate(locale, date)}`}
      title={title}
      align="bottom-left"
      minHeight="min-h-[68vh]"
    />
  </div>

  <section class="surface">
    <div class="container-custom py-16 desktop:py-24">
      <div class="mb-10">
        <a
          href={localePath(locale, '/blog')}
          class="eyebrow inline-flex items-center gap-2 hover:opacity-70 transition-opacity"
        >
          <span aria-hidden="true">←</span>
          {t('blog.back')}
        </a>
      </div>

      <article class="prose mx-auto max-w-prose" data-reveal>
        <slot />
      </article>
    </div>
  </section>
</Layout>

<style>
  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3) {
    font-family: var(--font-display, 'Fraunces'), serif;
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .prose :global(h1) {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .prose :global(h2) {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .prose :global(h3) {
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text);
  }

  .prose :global(p:first-of-type) {
    font-size: 1.25rem;
    line-height: 1.65;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.65;
  }

  .prose :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    transition: opacity 0.2s ease;
  }

  .prose :global(a:hover) {
    opacity: 0.7;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--text);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-family: var(--font-display, 'Fraunces'), serif;
    font-size: 1.5rem;
    line-height: 1.4;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    margin: 2.5rem 0;
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(em) {
    font-style: italic;
  }
</style>
