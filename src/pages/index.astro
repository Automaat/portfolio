---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { getCollection } from 'astro:content';

const trips = (await getCollection('trips')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const tiles = trips.map((trip, i) => ({
  href: `/trips/${trip.id}`,
  image: trip.data.thumbnail,
  title: trip.data.title,
  meta: `${trip.data.location} · ${trip.data.date}`,
  index: String(i + 1).padStart(2, '0'),
}));

const motionTile = {
  href: '/motion',
  image: '/images/hero-sailing.jpg',
  title: 'Showreel — Motion',
  meta: 'Selected motion work · 2022–2024',
  index: String(tiles.length + 1).padStart(2, '0'),
};
---

<Layout
  title="Marcin Skalski | Adventure, Travel & Marine Photographer"
  description="Adventure, travel, and marine photographer plus filmmaker for tourism brands, expeditions, and outdoor companies."
>
  <div class="-mt-16 desktop:-mt-20">
    <Hero
      image="/images/hero-home-desktop.jpg"
      imageWebp="/images/hero-home-desktop.webp"
      imageMobile="/images/hero-home-mobile.jpg"
      imageMobileWebp="/images/hero-home-mobile.webp"
      alt="View from inside a sailboat showing rigging and equipment"
      title="From the field, not the studio."
      subtitle="Adventure, travel, and marine — stills and motion for remote projects."
      align="bottom-left"
      minHeight="min-h-[92vh]"
    >
      <a
        slot="cta"
        href="/contact"
        class="mt-9 inline-flex font-mono text-[11px] uppercase tracking-[0.14em] text-white underline underline-offset-8 hover:opacity-70 transition-opacity"
      >
        Start a project →
      </a>
    </Hero>
  </div>

  <section class="surface">
    <div class="container-custom py-20 desktop:py-32">
      <div class="mb-14 desktop:mb-20 flex items-baseline justify-between">
        <p class="eyebrow">Selected work</p>
        <p class="eyebrow">2022–2024</p>
      </div>

      <div class="grid gap-y-16 desktop:gap-y-28">
        {
          tiles[0] && (
            <a href={tiles[0].href} class="tile group" data-reveal>
              <div class="tile-image aspect-[3/2] desktop:aspect-[21/10]">
                <img src={tiles[0].image} alt={tiles[0].title} loading="eager" decoding="async" />
              </div>
              <div class="tile-caption">
                <span>
                  {tiles[0].index} — {tiles[0].title}
                </span>
                <span class="text-subtle">{tiles[0].meta}</span>
              </div>
            </a>
          )
        }

        <div class="grid gap-y-16 desktop:grid-cols-12 desktop:gap-x-6">
          {
            tiles[1] && (
              <a href={tiles[1].href} class="tile group desktop:col-span-7" data-reveal>
                <div class="tile-image aspect-[4/3]">
                  <img src={tiles[1].image} alt={tiles[1].title} loading="lazy" decoding="async" />
                </div>
                <div class="tile-caption">
                  <span>
                    {tiles[1].index} — {tiles[1].title}
                  </span>
                  <span class="text-subtle">{tiles[1].meta}</span>
                </div>
              </a>
            )
          }
          {
            tiles[2] && (
              <a
                href={tiles[2].href}
                class="tile group desktop:col-span-5 desktop:mt-24"
                data-reveal
                data-reveal-delay="100"
              >
                <div class="tile-image aspect-[3/4]">
                  <img src={tiles[2].image} alt={tiles[2].title} loading="lazy" decoding="async" />
                </div>
                <div class="tile-caption">
                  <span>
                    {tiles[2].index} — {tiles[2].title}
                  </span>
                  <span class="text-subtle">{tiles[2].meta}</span>
                </div>
              </a>
            )
          }
        </div>

        <div class="grid gap-y-16 desktop:grid-cols-12 desktop:gap-x-6">
          {
            tiles[3] && (
              <a
                href={tiles[3].href}
                class="tile group desktop:col-span-5 desktop:mt-24"
                data-reveal
              >
                <div class="tile-image aspect-[3/4]">
                  <img src={tiles[3].image} alt={tiles[3].title} loading="lazy" decoding="async" />
                </div>
                <div class="tile-caption">
                  <span>
                    {tiles[3].index} — {tiles[3].title}
                  </span>
                  <span class="text-subtle">{tiles[3].meta}</span>
                </div>
              </a>
            )
          }
          {
            tiles[4] && (
              <a
                href={tiles[4].href}
                class="tile group desktop:col-span-7"
                data-reveal
                data-reveal-delay="100"
              >
                <div class="tile-image aspect-[4/3]">
                  <img src={tiles[4].image} alt={tiles[4].title} loading="lazy" decoding="async" />
                </div>
                <div class="tile-caption">
                  <span>
                    {tiles[4].index} — {tiles[4].title}
                  </span>
                  <span class="text-subtle">{tiles[4].meta}</span>
                </div>
              </a>
            )
          }
        </div>

        <a href={motionTile.href} class="tile group" data-reveal>
          <div class="tile-image aspect-[3/2] desktop:aspect-[21/9]">
            <img src={motionTile.image} alt={motionTile.title} loading="lazy" decoding="async" />
          </div>
          <div class="tile-caption">
            <span>
              {motionTile.index} — {motionTile.title}
            </span>
            <span class="text-subtle">{motionTile.meta}</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="surface border-t rule-line">
    <div class="container-custom py-24 desktop:py-40">
      <p class="eyebrow" data-reveal>Contact</p>
      <a
        href="mailto:marcin@skalski.com"
        class="mt-6 inline-block font-display text-[clamp(2rem,6vw,5.5rem)] leading-[1.05] hover:opacity-70 transition-opacity"
        data-reveal
        data-reveal-delay="80"
      >
        marcin@skalski.com
      </a>
      <p class="mt-8 max-w-md text-muted" data-reveal data-reveal-delay="140">
        Europe-based, available worldwide. Send location, timing, and deliverables — I’ll reply with
        fit and next step.
      </p>
    </div>
  </section>
</Layout>

<style>
  .tile {
    display: block;
  }

  .tile-image {
    overflow: hidden;
    background: var(--bg-elevated);
  }

  .tile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .tile:hover .tile-image img {
    transform: scale(1.03);
  }

  .tile-caption {
    margin-top: 1rem;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-family: theme('fontFamily.mono');
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
</style>
