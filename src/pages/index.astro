---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const trips = await getCollection('trips');
const featuredTrips = trips
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const workBuckets = [
  {
    title: 'Adventure campaigns',
    description: 'Stills and motion for destinations, expeditions, and outdoor launches.',
    href: '/work',
  },
  {
    title: 'Marine stories',
    description: 'Offshore access, life onboard, weather, and movement from the water.',
    href: '/work',
  },
  {
    title: 'Motion coverage',
    description: 'Reels, short films, drone, and social cutdowns for multi-format delivery.',
    href: '/motion',
  },
];

const services = [
  'Campaign stills',
  'Short films',
  'Drone capture',
  'Vertical cutdowns',
  'Destination libraries',
  'Photo + video coverage',
];

const differentiators = [
  'Europe-based, worldwide projects',
  'Offshore and expedition environments',
  'Remote-shoot planning and logistics',
  'Lean production for stills and motion',
];
---

<Layout
  title="Marcin Skalski | Adventure, Travel & Marine Photographer"
  description="Adventure, travel, and marine photographer plus filmmaker for tourism brands, expeditions, and outdoor companies."
>
  <section class="relative isolate min-h-[88vh] overflow-hidden bg-black text-white">
    <picture class="absolute inset-0">
      <source media="(max-width: 768px)" srcset="/images/hero-home-mobile.webp" type="image/webp" />
      <source media="(max-width: 768px)" srcset="/images/hero-home-mobile.jpg" />
      <source srcset="/images/hero-home-desktop.webp" type="image/webp" />
      <img
        src="/images/hero-home-desktop.jpg"
        alt="View from inside a sailboat showing rigging and equipment"
        class="h-full w-full object-cover"
        loading="eager"
      />
    </picture>

    <div
      class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,0.18)_0%,rgba(0,0,0,0.58)_62%,rgba(0,0,0,0.82)_100%)]"
    >
    </div>

    <div class="container-custom relative flex min-h-[88vh] items-end py-20 desktop:py-24">
      <div class="max-w-4xl">
        <p class="mb-5 text-xs font-medium uppercase tracking-[0.24em] text-white/75">
          Adventure • Travel • Marine
        </p>
        <h1 class="max-w-3xl text-4xl font-bold leading-[1.05] text-white desktop:text-[4.6rem]">
          Photo and motion for tourism brands, expeditions, and outdoor companies.
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-7 text-white/82 desktop:text-lg">
          Europe-based photographer and filmmaker building stills, reels, and campaign visuals in
          remote landscapes and offshore environments.
        </p>
        <div class="mt-8 flex flex-col gap-4 tablet:flex-row">
          <a
            href="/work"
            class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-xs font-medium uppercase tracking-[0.18em] text-black transition hover:bg-white/90"
          >
            View Work
          </a>
          <a
            href="mailto:marcin@skalski.com"
            class="inline-flex items-center justify-center rounded-full border border-white/60 px-6 py-3 text-xs font-medium uppercase tracking-[0.18em] text-white transition hover:border-white hover:bg-white/10"
          >
            Start Project
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-gray-200 bg-[#f6f5f1]">
    <div
      class="container-custom grid gap-6 py-6 text-xs font-medium uppercase tracking-[0.16em] text-gray-700 tablet:grid-cols-2 desktop:grid-cols-4"
    >
      <p>Europe-based, worldwide</p>
      <p>Adventure + marine access</p>
      <p>Stills + motion delivery</p>
      <p>Remote logistics ready</p>
    </div>
  </section>

  <section class="container-custom py-16 desktop:py-24">
    <div class="max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-[0.22em] text-accent-blue">Focus</p>
      <h2 class="mt-3 max-w-3xl text-3xl font-bold desktop:text-4xl">
        Built for buyers who need sharp visuals, real access, and clean delivery.
      </h2>
    </div>

    <div class="mt-10 grid gap-6 desktop:grid-cols-3">
      {
        workBuckets.map((bucket) => (
          <a
            href={bucket.href}
            class="group rounded-3xl border border-gray-200 bg-white p-8 transition hover:-translate-y-1 hover:border-gray-300 hover:shadow-[0_18px_60px_rgba(0,0,0,0.06)]"
          >
            <p class="text-xs font-medium uppercase tracking-[0.18em] text-accent-blue">Bucket</p>
            <h3 class="mt-4 text-2xl font-bold">{bucket.title}</h3>
            <p class="mt-4 text-gray-600">{bucket.description}</p>
            <span class="mt-8 inline-flex text-sm font-medium text-primary-text transition group-hover:text-accent-blue">
              Explore
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="bg-[#f8f8f5] py-16 desktop:py-24">
    <div class="container-custom">
      <div class="flex flex-col gap-4 desktop:flex-row desktop:items-end desktop:justify-between">
        <div class="max-w-2xl">
          <p class="text-xs font-medium uppercase tracking-[0.22em] text-accent-blue">
            Selected Work
          </p>
          <h2 class="mt-3 text-3xl font-bold desktop:text-4xl">
            Expedition stories with commercial range.
          </h2>
        </div>
        <a href="/work" class="text-sm font-medium text-primary-text underline underline-offset-4">
          See all work
        </a>
      </div>

      <div class="mt-10 grid gap-6 desktop:grid-cols-3">
        {
          featuredTrips.map((trip) => (
            <a
              href={`/trips/${trip.id}`}
              class="group overflow-hidden rounded-[2rem] bg-white shadow-[0_20px_80px_rgba(0,0,0,0.06)]"
            >
              <div class="aspect-square overflow-hidden">
                <img
                  src={trip.data.thumbnail}
                  alt={trip.data.title}
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
              <div class="space-y-3 p-6">
                <p class="text-xs font-medium uppercase tracking-[0.16em] text-accent-blue">
                  Case study seed
                </p>
                <h3 class="text-2xl font-bold">{trip.data.title}</h3>
                <p class="text-sm uppercase tracking-[0.16em] text-gray-500">
                  {trip.data.location}
                </p>
                <p class="text-gray-600">{trip.data.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-custom py-16 desktop:py-24">
    <div class="grid gap-12 desktop:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.22em] text-accent-blue">Services</p>
        <h2 class="mt-3 text-3xl font-bold desktop:text-4xl">
          Deliverables shaped for campaigns, launches, and content libraries.
        </h2>
        <div class="mt-8 grid gap-4 tablet:grid-cols-2">
          {
            services.map((service) => (
              <div class="rounded-2xl border border-gray-200 px-5 py-4 text-sm font-medium text-gray-700">
                {service}
              </div>
            ))
          }
        </div>
      </div>

      <div class="rounded-[2rem] bg-primary-text p-8 text-white">
        <p class="text-xs font-medium uppercase tracking-[0.22em] text-white/65">Why me</p>
        <h3 class="mt-4 text-2xl font-bold">
          Field-ready production without bloated crew overhead.
        </h3>
        <ul class="mt-8 space-y-4 text-white/80">
          {
            differentiators.map((item) => (
              <li class="border-b border-white/10 pb-4 last:border-b-0 last:pb-0">{item}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-[#e9ece4] py-16 desktop:py-24">
    <div
      class="container-custom flex flex-col gap-6 desktop:flex-row desktop:items-end desktop:justify-between"
    >
      <div class="max-w-2xl">
        <p class="text-xs font-medium uppercase tracking-[0.22em] text-accent-blue">Contact</p>
        <h2 class="mt-3 text-3xl font-bold desktop:text-4xl">
          Need stills, motion, or both for a remote project?
        </h2>
        <p class="mt-4 text-gray-700">
          Share location, timing, and deliverables. I’ll respond with fit, approach, and next step.
        </p>
      </div>

      <div class="flex flex-col gap-4 tablet:flex-row">
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-full bg-primary-text px-6 py-3 text-xs font-medium uppercase tracking-[0.18em] text-white transition hover:bg-black"
        >
          Contact
        </a>
        <a
          href="mailto:marcin@skalski.com"
          class="inline-flex items-center justify-center rounded-full border border-primary-text px-6 py-3 text-xs font-medium uppercase tracking-[0.18em] text-primary-text transition hover:bg-primary-text hover:text-white"
        >
          marcin@skalski.com
        </a>
      </div>
    </div>
  </section>
</Layout>
