---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const trips = (await getCollection('trips')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const rows = trips.map((t, i) => ({
  href: `/trips/${t.id}`,
  title: t.data.title,
  location: t.data.location,
  year: t.data.date.match(/\d{4}/)?.[0] ?? t.data.date,
  image: t.data.thumbnail,
  index: String(i + 1).padStart(2, '0'),
}));

const showreel = {
  href: '/motion',
  title: 'Showreel — Motion',
  location: 'Selected motion work',
  year: '2022–24',
  image: '/images/hero-sailing.jpg',
  index: String(rows.length + 1).padStart(2, '0'),
};
---

<Layout
  title="Marcin Skalski | Adventure, Travel & Marine Photographer"
  description="Adventure, travel, and marine photographer plus filmmaker for tourism brands, expeditions, and outdoor companies."
  headerLogo={false}
>
  <section
    class="container-custom pt-10 desktop:pt-16 pb-8 flex flex-col justify-center desktop:justify-between min-h-[calc(100svh-4rem)] desktop:min-h-[calc(100svh-5rem)]"
  >
    <h1 class="masthead font-display uppercase">
      <span class="masthead-l1 block">Marcin</span>
      <span class="masthead-l2 block italic"
        >Skalski<span class="masthead-dot text-[color:var(--accent)]">.</span></span
      >
    </h1>
    <div class="mt-10 flex flex-wrap justify-between gap-3">
      <p class="eyebrow">Adventure · Travel · Marine</p>
      <p class="eyebrow hidden tablet:block">Selected work ↓</p>
      <p class="eyebrow">Europe — Worldwide</p>
    </div>
  </section>

  <section class="container-custom mt-6 desktop:mt-10">
    <div class="border-t border-[color:var(--text)]">
      {
        [...rows, showreel].map((row) => (
          <a class="row group" href={row.href} data-image={row.image} data-reveal>
            <span class="row-aux">{row.index}</span>
            <span class="row-title font-display">{row.title}</span>
            <span class="row-aux hidden tablet:block">{row.location}</span>
            <span class="row-aux text-right">{row.year}</span>
          </a>
        ))
      }
    </div>
  </section>

  <div id="preview" aria-hidden="true">
    <img src={rows[0]?.image} alt="" />
  </div>

  <section class="mt-[12vh] h-[72vh]">
    <img
      src="/images/hero-sailing.jpg"
      alt="Sailboat on calm open water at dusk"
      class="h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </section>

  <section class="container-custom py-[12vh]">
    <p class="eyebrow" data-reveal>New projects</p>
    <a
      href="mailto:marcin@skalski.com"
      class="contact-mail mt-6 inline-block font-display leading-none"
      data-reveal
      data-reveal-delay="80"
    >
      marcin@skalski.com
    </a>
    <p class="mt-8 max-w-md text-muted" data-reveal data-reveal-delay="140">
      Europe-based, available worldwide. Send location, timing, and deliverables — I’ll reply with
      fit and next step.
    </p>
  </section>
</Layout>

<script>
  const preview = document.getElementById('preview') as HTMLDivElement | null;
  const img = preview?.querySelector('img');
  const fine = window.matchMedia('(pointer: fine)').matches;

  if (preview && img && fine) {
    let x = 0,
      y = 0,
      tx = 0,
      ty = 0,
      visible = false;

    document.querySelectorAll<HTMLAnchorElement>('.row').forEach((row) => {
      row.addEventListener('mouseenter', () => {
        img.src = row.dataset.image ?? '';
        visible = true;
        preview.classList.add('on');
      });
      row.addEventListener('mouseleave', () => {
        visible = false;
        preview.classList.remove('on');
      });
    });

    document.addEventListener('mousemove', (e) => {
      tx = e.clientX;
      ty = e.clientY;
    });

    const tick = () => {
      x += (tx - x) * 0.12;
      y += (ty - y) * 0.12;
      if (visible) preview.style.transform = `translate(${x + 24}px, ${y - 140}px)`;
      requestAnimationFrame(tick);
    };
    tick();
  }
</script>

<style>
  .masthead {
    container-type: inline-size;
    line-height: 0.8;
    letter-spacing: -0.025em;
    font-weight: 480;
    font-optical-sizing: auto;
  }

  .masthead-l1,
  .masthead-l2 {
    white-space: nowrap;
  }

  .masthead-l1 {
    font-size: 24vw;
    font-size: 27.2cqw;
  }

  .masthead-l2 {
    font-size: 22vw;
    font-size: 25cqw;
    font-weight: 380;
    margin-top: 0.02em;
  }

  .masthead-dot {
    font-style: normal;
    font-size: 0.72em;
    line-height: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 3rem 1fr 5rem;
    align-items: baseline;
    gap: 2rem;
    padding: 2.1rem 0;
    border-bottom: 1px solid var(--rule);
    transition: padding-left 0.45s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  @media (min-width: 737px) {
    .row {
      grid-template-columns: 3rem 1fr auto 5rem;
    }
  }

  .row:last-child {
    border-bottom-color: var(--text);
  }

  .row:hover {
    padding-left: 1.5rem;
    opacity: 1;
  }

  .row-aux {
    font-family: theme('fontFamily.mono');
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
  }

  .row-title {
    font-size: clamp(1.7rem, 3.6vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  #preview {
    position: fixed;
    top: 0;
    left: 0;
    width: 26rem;
    aspect-ratio: 4 / 3;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 40;
    overflow: hidden;
  }

  #preview.on {
    opacity: 1;
  }

  #preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 736px) {
    #preview {
      display: none;
    }
  }

  .contact-mail {
    font-size: clamp(1.9rem, 6.5vw, 6.5rem);
    letter-spacing: -0.02em;
  }

  .contact-mail:hover {
    font-style: italic;
    opacity: 1;
  }
</style>
