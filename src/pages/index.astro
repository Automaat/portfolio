---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { getCollection } from 'astro:content';

const trips = await getCollection('trips');
const featuredTrips = trips
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const lead = featuredTrips[0];
const seconds = featuredTrips.slice(1, 3);

const gateways = [
  {
    title: 'Adventure',
    description: 'Expedition stills and motion. Routes, weather, movement.',
    href: '/work',
    image: '/images/trips/patagonia-thumb.jpg',
  },
  {
    title: 'Marine',
    description: 'On-water access. Coastlines, sailing, offshore.',
    href: '/work',
    image: '/images/trips/norway-thumb.jpg',
  },
  {
    title: 'Motion',
    description: 'Reels, short films, drone, vertical cutdowns.',
    href: '/motion',
    image: '/images/trips/iceland-thumb.jpg',
  },
];

const proof = [
  'Adventure',
  'Tourism',
  'Marine',
  'Outdoor brands',
  'Editorial',
  'Expedition operators',
];

const differentiators = [
  'Europe-based, worldwide projects',
  'Offshore and expedition environments',
  'Remote-shoot planning and logistics',
  'Lean production for stills and motion',
];
---

<Layout
  title="Marcin Skalski | Adventure, Travel & Marine Photographer"
  description="Adventure, travel, and marine photographer plus filmmaker for tourism brands, expeditions, and outdoor companies."
>
  <div class="-mt-16 desktop:-mt-20">
    <Hero
      image="/images/hero-home-desktop.jpg"
      imageWebp="/images/hero-home-desktop.webp"
      imageMobile="/images/hero-home-mobile.jpg"
      imageMobileWebp="/images/hero-home-mobile.webp"
      alt="View from inside a sailboat showing rigging and equipment"
      eyebrow="Adventure · Travel · Marine"
      title="Photo and motion from the field, not the studio."
      subtitle="Europe-based photographer and filmmaker building stills, reels, and campaign visuals in remote landscapes and offshore environments."
      align="bottom-left"
      minHeight="min-h-[92vh]"
    >
      <div slot="cta" class="mt-10 flex flex-col gap-3 tablet:flex-row">
        <a
          href="/work"
          class="inline-flex items-center justify-center bg-white px-7 py-3.5 text-[11px] font-semibold uppercase font-mono tracking-[0.14em] text-black hover:bg-white/90 transition"
        >
          View Work
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center border border-white/50 px-7 py-3.5 text-[11px] font-semibold uppercase font-mono tracking-[0.14em] text-white hover:border-white hover:bg-white/10 transition"
        >
          Start a Project
        </a>
      </div>
    </Hero>
  </div>

  <section class="surface border-y rule-line overflow-hidden">
    <div class="container-custom py-6">
      <div
        class="flex flex-wrap justify-center gap-x-10 gap-y-3 text-[11px] uppercase font-mono tracking-[0.18em] text-muted"
      >
        {
          proof.map((item, i) => (
            <span class="flex items-center gap-10">
              <span>{item}</span>
              {i < proof.length - 1 && (
                <span class="opacity-40" aria-hidden="true">
                  ·
                </span>
              )}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <section class="surface">
    <div class="container-custom py-20 desktop:py-32">
      <div class="flex flex-col desktop:flex-row desktop:items-end justify-between gap-6 mb-14">
        <div class="max-w-2xl" data-reveal>
          <p class="eyebrow">Where I work</p>
          <h2 class="mt-4 font-display text-[clamp(2rem,5vw,4.5rem)] leading-[1.02]">
            Three lanes. One field-ready production.
          </h2>
        </div>
        <p class="max-w-md text-muted" data-reveal data-reveal-delay="120">
          Built for buyers who need real access, sharp visuals, and clean delivery — from remote
          terrain to the water.
        </p>
      </div>

      <div class="grid gap-3 desktop:grid-cols-3">
        {
          gateways.map((gw, i) => (
            <a href={gw.href} class="gateway group" data-reveal data-reveal-delay={`${i * 100}`}>
              <div class="gateway-image">
                <img src={gw.image} alt={gw.title} loading="lazy" decoding="async" />
              </div>
              <div class="gateway-overlay" />
              <div class="gateway-content">
                <p class="text-[11px] uppercase font-mono tracking-[0.18em] text-white/70">
                  0{i + 1}
                </p>
                <h3 class="mt-3 font-display text-3xl text-white leading-tight">{gw.title}</h3>
                <p class="mt-3 text-sm text-white/85 max-w-[28ch]">{gw.description}</p>
                <span class="mt-6 inline-flex items-center gap-2 text-[11px] uppercase font-mono tracking-[0.14em] text-white">
                  Explore <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="surface-soft">
    <div class="container-custom py-20 desktop:py-32">
      <div class="flex flex-col desktop:flex-row desktop:items-end justify-between gap-6 mb-14">
        <div class="max-w-2xl" data-reveal>
          <p class="eyebrow">Selected work</p>
          <h2 class="mt-4 font-display text-[clamp(2rem,5vw,4.5rem)] leading-[1.02]">
            Expedition stories with commercial range.
          </h2>
        </div>
        <a
          href="/work"
          class="self-start desktop:self-end text-[11px] uppercase font-mono tracking-[0.14em] underline underline-offset-8 hover:opacity-70"
        >
          See all work →
        </a>
      </div>

      {
        lead && (
          <a
            href={`/trips/${lead.id}`}
            class="featured-lead group block mb-3 desktop:mb-6"
            data-reveal
          >
            <div class="featured-lead-image">
              <img
                src={lead.data.thumbnail}
                alt={lead.data.title}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="grid gap-4 desktop:grid-cols-[1fr_1fr] desktop:gap-12 mt-6">
              <div>
                <p class="eyebrow">
                  {lead.data.format ?? 'Field project'} · {lead.data.date}
                </p>
                <h3 class="mt-3 font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05]">
                  {lead.data.title}
                </h3>
              </div>
              <p class="text-muted text-lg leading-relaxed self-end">{lead.data.description}</p>
            </div>
          </a>
        )
      }

      <div class="grid gap-3 desktop:grid-cols-2 desktop:gap-6">
        {
          seconds.map((trip, i) => (
            <a
              href={`/trips/${trip.id}`}
              class="featured-secondary group"
              data-reveal
              data-reveal-delay={`${(i + 1) * 100}`}
            >
              <div class="featured-secondary-image">
                <img
                  src={trip.data.thumbnail}
                  alt={trip.data.title}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="mt-5">
                <p class="eyebrow">
                  {trip.data.format ?? 'Field project'} · {trip.data.date}
                </p>
                <h3 class="mt-2 font-display text-2xl desktop:text-3xl leading-[1.1]">
                  {trip.data.title}
                </h3>
                <p class="mt-2 text-sm text-muted">{trip.data.location}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="surface">
    <div class="container-custom py-20 desktop:py-32">
      <div class="grid gap-12 desktop:grid-cols-[1.1fr_0.9fr] desktop:gap-20">
        <div data-reveal>
          <p class="eyebrow">Why me</p>
          <h2 class="mt-4 font-display text-[clamp(2rem,5vw,4rem)] leading-[1.02]">
            Field-ready production without bloated crew overhead.
          </h2>
          <p class="mt-6 text-lg text-muted max-w-xl">
            One production window, lean kit, real access. Stills, reels, social cutdowns, and
            destination libraries delivered without dragging a film crew across the country.
          </p>
        </div>

        <ul class="border-t rule-line" data-reveal data-reveal-delay="100">
          {
            differentiators.map((item, i) => (
              <li class="border-b rule-line py-5 flex gap-6 items-baseline">
                <span class="eyebrow w-10 shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-lg leading-snug">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="surface-elevated">
    <div
      class="container-custom py-20 desktop:py-32 flex flex-col gap-8 desktop:flex-row desktop:items-end desktop:justify-between"
    >
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Contact</p>
        <h2 class="mt-4 font-display text-[clamp(2rem,5vw,4.5rem)] leading-[1.02]">
          Stills, motion, or both — for one remote project.
        </h2>
        <p class="mt-6 text-lg text-muted">
          Send location, timing, deliverables, and a budget range. I’ll respond with fit, approach,
          and next step.
        </p>
      </div>

      <div class="flex flex-col gap-3 tablet:flex-row" data-reveal data-reveal-delay="120">
        <a
          href="/contact"
          class="inline-flex items-center justify-center bg-[color:var(--text)] text-[color:var(--bg)] px-7 py-3.5 text-[11px] font-semibold uppercase font-mono tracking-[0.14em] hover:opacity-85 transition-opacity"
        >
          Inquiry form
        </a>
        <a
          href="mailto:marcin@skalski.com"
          class="inline-flex items-center justify-center border border-[color:var(--text)] px-7 py-3.5 text-[11px] font-semibold uppercase font-mono tracking-[0.14em] hover:bg-[color:var(--text)] hover:text-[color:var(--bg)] transition-colors"
        >
          marcin@skalski.com
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .gateway {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-elevated);
    color: white;
  }

  @media (min-width: 1025px) {
    .gateway {
      aspect-ratio: 3 / 4;
    }
  }

  .gateway-image {
    position: absolute;
    inset: 0;
  }

  .gateway-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .gateway:hover .gateway-image img {
    transform: scale(1.05);
  }

  .gateway-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.15) 0%,
      rgba(0, 0, 0, 0.55) 60%,
      rgba(0, 0, 0, 0.85) 100%
    );
  }

  .gateway-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
  }

  @media (min-width: 1025px) {
    .gateway-content {
      padding: 2.5rem;
    }
  }

  .featured-lead-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-elevated);
  }

  .featured-lead-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .featured-lead:hover .featured-lead-image img {
    transform: scale(1.03);
  }

  .featured-secondary-image {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-elevated);
  }

  .featured-secondary-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .featured-secondary:hover .featured-secondary-image img {
    transform: scale(1.03);
  }
</style>
