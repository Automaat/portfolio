---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';

const pageTitle = 'Contact | Marcin Skalski';
const pageDescription =
  'Start a photography or motion project with Marcin Skalski. Share location, timing, deliverables, and budget range.';
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="border-b border-gray-200 bg-[#f6f5f1]">
    <div class="container-custom py-16 desktop:py-24">
      <p class="text-xs font-medium uppercase tracking-[0.22em] text-accent-blue">Contact</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-bold leading-[1.05] desktop:text-[4.2rem]">
        Start with the brief: location, timing, deliverables, and budget range.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-gray-700">
        Best fit for adventure, travel, and marine projects needing stills, motion, or hybrid
        coverage.
      </p>
    </div>
  </section>

  <section class="container-custom py-16 desktop:py-24">
    <div class="grid gap-10 desktop:grid-cols-[0.7fr_1.3fr]">
      <div class="space-y-6">
        <div class="overflow-hidden rounded-[2rem]">
          <img
            src="/images/trips/norway-thumb.jpg"
            alt="Norwegian fjord from Marcin Skalski portfolio"
            class="aspect-[4/5] h-full w-full object-cover"
            loading="lazy"
          />
        </div>

        <div class="rounded-[2rem] bg-primary-text p-8 text-white">
          <p class="text-xs font-medium uppercase tracking-[0.22em] text-white/60">Direct</p>
          <a href="mailto:marcin@skalski.com" class="mt-4 block text-2xl font-bold">
            marcin@skalski.com
          </a>
          <p class="mt-4 text-white/75">Europe-based. Available worldwide.</p>
          <div class="mt-8 space-y-3 text-white/75">
            <p>Useful detail to include:</p>
            <ul class="space-y-2">
              <li>Project type</li>
              <li>Location and dates</li>
              <li>Needed outputs</li>
              <li>Budget range</li>
            </ul>
          </div>
        </div>
      </div>

      <div>
        <div class="max-w-2xl">
          <p class="text-xs font-medium uppercase tracking-[0.22em] text-accent-blue">
            Inquiry form
          </p>
          <h2 class="mt-3 text-3xl font-bold desktop:text-4xl">Enough detail to judge fit fast.</h2>
          <p class="mt-4 text-gray-700">
            The more specific the brief, the faster I can respond with approach and next step.
          </p>
        </div>

        <div class="mt-10">
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
</Layout>
