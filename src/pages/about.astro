---
import Layout from '../layouts/Layout.astro';

const title = 'About | Marcin Skalski';
const description =
  'Adventure, travel, and marine photographer plus filmmaker based in Europe and available for remote assignments.';

const strengths = [
  {
    title: 'Adventure + marine range',
    description:
      'Useful when a project spans coastline, weather, boats, landscapes, and people in motion.',
  },
  {
    title: 'Field logistics mindset',
    description:
      'Built around lightweight production, location planning, shifting conditions, and practical access.',
  },
  {
    title: 'Stills + motion in one shoot',
    description:
      'One production window can feed campaign selects, social assets, and short-form video.',
  },
];

const fit = [
  'Tourism and destination campaigns',
  'Marine and sailing brands',
  'Expedition and charter operators',
  'Outdoor launches and content libraries',
];
---

<Layout title={title} description={description}>
  <section class="relative isolate overflow-hidden bg-black text-white">
    <img
      src="/images/hero-home-desktop.jpg"
      alt="View from inside a sailboat showing rigging and equipment"
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
    />
    <div
      class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,0.25)_0%,rgba(0,0,0,0.6)_55%,rgba(0,0,0,0.82)_100%)]"
    >
    </div>

    <div class="container-custom relative py-20 desktop:py-28">
      <p class="text-xs font-medium uppercase tracking-[0.22em] text-white/65">About</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-bold leading-[1.05] desktop:text-[4.2rem]">
        Photographer and filmmaker for remote places, weather, and movement.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-white/78">
        I work across adventure, travel, and marine assignments with a bias toward real conditions,
        practical access, and clean delivery.
      </p>
    </div>
  </section>

  <section class="container-custom py-16 desktop:py-24">
    <div class="grid gap-12 desktop:grid-cols-[0.95fr_1.05fr] desktop:items-start">
      <div class="overflow-hidden rounded-[2rem]">
        <img
          src="/images/trips/patagonia-thumb.jpg"
          alt="Patagonia mountain landscape from Marcin Skalski portfolio"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>

      <div>
        <p class="text-xs font-medium uppercase tracking-[0.22em] text-accent-blue">Profile</p>
        <h2 class="mt-3 text-3xl font-bold desktop:text-4xl">
          Europe-based. Available for destination, expedition, and marine work worldwide.
        </h2>
        <div class="mt-6 space-y-5 text-lg leading-8 text-gray-700">
          <p>
            My work sits where landscape, access, and story meet. I shoot stills and motion for
            teams that need visual coverage in demanding locations without turning the production
            into a heavy operation.
          </p>
          <p>
            A sailing background helps on assignments where timing, weather, water access, and
            onboard movement are part of the brief. On land, the same approach carries into
            expedition routes, destination campaigns, and outdoor product stories.
          </p>
          <p>
            The goal is simple: strong imagery, useful deliverables, and a process that holds up in
            the field.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[#f8f8f5] py-16 desktop:py-24">
    <div class="container-custom">
      <div class="max-w-2xl">
        <p class="text-xs font-medium uppercase tracking-[0.22em] text-accent-blue">Strengths</p>
        <h2 class="mt-3 text-3xl font-bold desktop:text-4xl">
          Why buyers bring me into remote assignments.
        </h2>
      </div>

      <div class="mt-10 grid gap-6 desktop:grid-cols-3">
        {
          strengths.map((item) => (
            <div class="rounded-[2rem] border border-gray-200 bg-white p-8">
              <h3 class="text-2xl font-bold">{item.title}</h3>
              <p class="mt-4 text-gray-600">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-custom py-16 desktop:py-24">
    <div class="grid gap-12 desktop:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.22em] text-accent-blue">Best fit</p>
        <h2 class="mt-3 text-3xl font-bold desktop:text-4xl">
          Best aligned with brands and operators needing access, pace, and place.
        </h2>
      </div>

      <div class="grid gap-4 tablet:grid-cols-2">
        {
          fit.map((item) => (
            <div class="rounded-3xl border border-gray-200 px-6 py-5 text-gray-700">{item}</div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-primary-text py-16 text-white desktop:py-24">
    <div
      class="container-custom flex flex-col gap-6 desktop:flex-row desktop:items-end desktop:justify-between"
    >
      <div class="max-w-2xl">
        <p class="text-xs font-medium uppercase tracking-[0.22em] text-white/60">Contact</p>
        <h2 class="mt-3 text-3xl font-bold desktop:text-4xl">
          Have a destination, expedition, or marine brief?
        </h2>
        <p class="mt-4 text-white/75">
          Send timing, location, and needed outputs. I’ll reply with fit and next step.
        </p>
      </div>

      <div class="flex flex-col gap-4 tablet:flex-row">
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-xs font-medium uppercase tracking-[0.18em] text-black transition hover:bg-white/90"
        >
          Contact
        </a>
        <a
          href="mailto:marcin@skalski.com"
          class="inline-flex items-center justify-center rounded-full border border-white/40 px-6 py-3 text-xs font-medium uppercase tracking-[0.18em] text-white transition hover:border-white hover:bg-white/10"
        >
          marcin@skalski.com
        </a>
      </div>
    </div>
  </section>
</Layout>
