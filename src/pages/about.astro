---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ContactBand from '../components/ContactBand.astro';

const title = 'About | Marcin Skalski';
const description =
  'Adventure, travel, and marine photographer plus filmmaker based in Europe and available for remote assignments.';

const strengths = [
  {
    title: 'Adventure + marine range',
    description:
      'Useful when a project spans coastline, weather, boats, landscapes, and people in motion.',
  },
  {
    title: 'Field logistics mindset',
    description:
      'Built around lightweight production, location planning, shifting conditions, and practical access.',
  },
  {
    title: 'Stills + motion in one shoot',
    description:
      'One production window can feed campaign selects, social assets, and short-form video.',
  },
];
---

<Layout title={title} description={description}>
  <div class="-mt-16 desktop:-mt-20">
    <Hero
      image="/images/hero-home-desktop.jpg"
      imageWebp="/images/hero-home-desktop.webp"
      imageMobile="/images/hero-home-mobile.jpg"
      imageMobileWebp="/images/hero-home-mobile.webp"
      alt="View from inside a sailboat showing rigging and equipment"
      eyebrow="About"
      title="Photographer and filmmaker for remote places, weather, and movement."
      subtitle="I work across adventure, travel, and marine assignments with a bias toward real conditions, practical access, and clean delivery."
      align="bottom-left"
      minHeight="min-h-[78vh]"
    />
  </div>

  <section class="surface">
    <div class="container-custom py-20 desktop:py-32">
      <div class="grid gap-12 desktop:grid-cols-[0.95fr_1.05fr] desktop:gap-20 items-start">
        <div class="overflow-hidden" data-reveal>
          <img
            src="/images/trips/patagonia-thumb.jpg"
            alt="Patagonia mountain landscape"
            class="w-full h-auto aspect-[4/5] object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div data-reveal data-reveal-delay="120">
          <p class="eyebrow">Profile</p>
          <h2 class="mt-4 font-display text-[clamp(2rem,5vw,4rem)] leading-[1.05]">
            Europe-based. Available for destination, expedition, and marine work worldwide.
          </h2>
          <div class="mt-8 space-y-6 text-lg leading-relaxed text-muted">
            <p>
              My work sits where landscape, access, and story meet. Stills and motion for teams that
              need visual coverage in demanding locations, without turning the production into a
              heavy operation.
            </p>
            <p>
              A sailing background helps on assignments where timing, weather, water access, and
              onboard movement are part of the brief. On land, the same approach carries into
              expedition routes, destination campaigns, and outdoor product stories.
            </p>
            <p class="text-[color:var(--text)]">
              Strong imagery, useful deliverables, and a process that holds up in the field.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="surface-soft">
    <div class="container-custom py-20 desktop:py-32">
      <div class="max-w-2xl mb-14" data-reveal>
        <p class="eyebrow">Strengths</p>
        <h2 class="mt-4 font-display text-[clamp(2rem,5vw,4rem)] leading-[1.05]">
          Why buyers bring me into remote assignments.
        </h2>
      </div>

      <div class="grid gap-0 border-t rule-line">
        {
          strengths.map((item, i) => (
            <div
              class="border-b rule-line py-8 grid gap-4 desktop:grid-cols-[0.4fr_0.6fr] desktop:gap-12"
              data-reveal
              data-reveal-delay={`${i * 100}`}
            >
              <h3 class="font-display text-2xl desktop:text-3xl leading-[1.1]">
                {String(i + 1).padStart(2, '0')} — {item.title}
              </h3>
              <p class="text-muted text-lg leading-relaxed">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ContactBand label="Have a destination, expedition, or marine brief?" />
</Layout>
