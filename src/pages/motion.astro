---
import Layout from '../layouts/Layout.astro';
import VideoFrame from '../components/VideoFrame.astro';
import ContactBand from '../components/ContactBand.astro';

// videoId is optional. When set, the play button loads the YouTube embed inline.
// When unset, the play button opens the YouTube channel in a new tab.
const reel = {
  title: 'Showreel — Adventure, Travel & Marine',
  caption: 'Selected motion work, 2022–2024',
  poster: '/images/hero-home-desktop.jpg',
  videoId: '',
};

const films = [
  {
    title: 'Patagonia — Wind, Granite, Ice',
    caption: 'Adventure short · 2024',
    poster: '/images/trips/patagonia-thumb.jpg',
    videoId: '',
  },
  {
    title: 'Iceland — Black Sand to Aurora',
    caption: 'Tourism story · 2023',
    poster: '/images/trips/iceland-thumb.jpg',
    videoId: '',
  },
  {
    title: 'Norwegian Fjords — Bergen to Lofoten',
    caption: 'Marine feature · 2023',
    poster: '/images/trips/norway-thumb.jpg',
    videoId: '',
  },
  {
    title: 'Highlands — Storm Window',
    caption: 'Outdoor commission seed · 2022',
    poster: '/images/trips/scotland-thumb.jpg',
    videoId: '',
  },
];
---

<Layout
  title="Motion | Marcin Skalski"
  description="Motion direction and field-ready production for adventure, travel, and marine campaigns."
>
  <section class="surface">
    <div class="container-custom pt-20 pb-12 desktop:pt-28 desktop:pb-16 border-b rule-line">
      <p class="eyebrow">Motion</p>
      <h1 class="mt-4 font-display text-[clamp(2.5rem,7vw,6rem)] leading-[1] max-w-5xl" data-reveal>
        Short-form motion built for outdoor brands, tourism, and expedition stories.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted" data-reveal data-reveal-delay="120">
        Reels, brand films, destination cuts, and hybrid stills/motion coverage. Lean kit, real
        access, and a delivery window that fits a single field shoot.
      </p>
    </div>
  </section>

  <section class="surface">
    <div class="container-custom py-12 desktop:py-20">
      <div class="mb-8 flex items-end justify-between gap-6" data-reveal>
        <div>
          <p class="eyebrow">Featured reel</p>
          <h2 class="mt-3 font-display text-3xl desktop:text-4xl">Latest cut.</h2>
        </div>
        <a
          href="https://www.youtube.com/@marcinskalski2201"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[11px] uppercase font-mono tracking-[0.14em] underline underline-offset-8 hover:opacity-70"
        >
          Channel →
        </a>
      </div>
      <div data-reveal data-reveal-delay="100">
        <VideoFrame
          videoId={reel.videoId}
          poster={reel.poster}
          title={reel.title}
          caption={reel.caption}
          aspect="21/9"
        />
      </div>
    </div>
  </section>

  <section class="surface-soft">
    <div class="container-custom py-20 desktop:py-32">
      <div class="mb-12 flex items-end justify-between gap-6" data-reveal>
        <div class="max-w-2xl">
          <p class="eyebrow">Films</p>
          <h2 class="mt-3 font-display text-[clamp(2rem,5vw,4rem)] leading-[1.05]">
            Selected pieces from the field.
          </h2>
        </div>
      </div>

      <div class="grid gap-10 desktop:grid-cols-2 desktop:gap-x-8 desktop:gap-y-16">
        {
          films.map((f, i) => (
            <div data-reveal data-reveal-delay={`${i * 80}`}>
              <VideoFrame
                videoId={f.videoId}
                poster={f.poster}
                title={f.title}
                caption={f.caption}
                aspect="16/9"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ContactBand label="Reels, cutdowns, or hybrid coverage in mind?" />
</Layout>
