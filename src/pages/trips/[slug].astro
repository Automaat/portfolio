---
import { getCollection, render } from 'astro:content';
import TripLayout from '../../layouts/TripLayout.astro';

export async function getStaticPaths() {
  const trips = await getCollection('trips');
  return trips.map((trip) => ({
    params: { slug: trip.id },
    props: { trip },
  }));
}

const { trip } = Astro.props;
const { Content } = await render(trip);
---

<TripLayout
  title={trip.data.title}
  location={trip.data.location}
  date={trip.data.date}
  description={trip.data.description}
  thumbnail={trip.data.thumbnail}
  images={trip.data.images}
  client={trip.data.client}
  format={trip.data.format}
  role={trip.data.role}
  brief={trip.data.brief}
  deliverables={trip.data.deliverables}
  outcome={trip.data.outcome}
>
  <Content />
</TripLayout>
