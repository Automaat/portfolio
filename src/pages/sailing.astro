---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';

const yachtPhotos = [
  { src: '/images/yacht-1.jpg', alt: 'Sailing yacht at sea', ratio: 'wide' as const },
  { src: '/images/yacht-2.jpg', alt: 'Yacht interior cabin', ratio: 'portrait' as const },
  { src: '/images/yacht-3.jpg', alt: 'Sunset sailing', ratio: 'landscape' as const },
  { src: '/images/yacht-4.jpg', alt: 'Yacht deck view', ratio: 'square' as const },
  { src: '/images/yacht-5.jpg', alt: 'Navigation equipment', ratio: 'tall' as const },
];

const services = [
  {
    title: 'Skippered charters',
    description:
      'Professional yacht charter with experienced skipper. Navigate challenging waters while you enjoy the journey.',
  },
  {
    title: 'Sailing expeditions',
    description:
      'Multi-day sailing adventures to remote destinations with offshore-grade planning and support.',
  },
  {
    title: 'Sailing instruction',
    description:
      'Personalised lessons across skill levels — basic navigation through advanced offshore technique.',
  },
];

const credentials = [
  'RYA Yachtmaster Ocean',
  'STCW Basic Safety Training',
  'Advanced First Aid at Sea',
  'VHF Radio Operator License',
  'Coastal Navigation & Meteorology',
  '10,000+ Nautical Miles Logged',
];
---

<Layout
  title="Sailing & Skipper Services | Marcin Skalski"
  description="Professional sailing and skippered charter services. Expeditions, instruction, and yacht charters with experienced skipper Marcin Skalski."
>
  <div class="-mt-16 desktop:-mt-20">
    <Hero
      image="/images/hero-sailing.jpg"
      alt="Sailing yacht on open water"
      eyebrow="Sailing & Skipper"
      title="Sailing services on the open water."
      subtitle="Skippered charter, expeditions, and instruction — built around real conditions."
      align="bottom-left"
      minHeight="min-h-[80vh]"
    />
  </div>

  <section class="surface">
    <div class="container-custom py-20 desktop:py-32">
      <div class="grid gap-12 desktop:grid-cols-[1fr_1fr] desktop:gap-20">
        <div data-reveal>
          <p class="eyebrow">Experience</p>
          <h2 class="mt-4 font-display text-[clamp(2rem,5vw,4rem)] leading-[1.05]">
            Years of offshore miles. A bias for the practical.
          </h2>
          <div class="mt-8 space-y-5 text-lg text-muted leading-relaxed">
            <p>
              Years of navigating challenging waters across multiple continents, combining technical
              proficiency with respect for the ocean and a non-negotiable on safety.
            </p>
            <p>
              Coastal cruising, offshore expeditions, charter and instruction — accumulated miles in
              the conditions that matter most.
            </p>
          </div>
        </div>

        <div class="border-t rule-line" data-reveal data-reveal-delay="100">
          <p class="eyebrow pt-6">Certifications</p>
          <ul class="mt-4">
            {credentials.map((c) => <li class="border-b rule-line py-4 text-base">{c}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="surface-soft">
    <div class="container-custom py-20 desktop:py-32">
      <div class="max-w-2xl mb-12" data-reveal>
        <p class="eyebrow">Services</p>
        <h2 class="mt-4 font-display text-[clamp(2rem,5vw,4rem)] leading-[1.05]">
          What you can book.
        </h2>
      </div>

      <div class="grid gap-0 border-t rule-line">
        {
          services.map((s, i) => (
            <div
              class="border-b rule-line py-8 grid gap-4 desktop:grid-cols-[0.4fr_0.6fr] desktop:gap-12"
              data-reveal
              data-reveal-delay={`${i * 80}`}
            >
              <h3 class="font-display text-2xl desktop:text-3xl leading-[1.1]">
                {String(i + 1).padStart(2, '0')} — {s.title}
              </h3>
              <p class="text-muted text-lg leading-relaxed">{s.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="surface">
    <div class="container-custom py-20 desktop:py-32">
      <div class="max-w-2xl mb-12" data-reveal>
        <p class="eyebrow">The vessel</p>
        <h2 class="mt-4 font-display text-[clamp(2rem,5vw,4rem)] leading-[1.05]">
          Equipped for comfort, safety, and performance.
        </h2>
      </div>
      <Gallery images={yachtPhotos} alt="Yacht" />
    </div>
  </section>

  <section class="surface-elevated">
    <div
      class="container-custom py-20 desktop:py-32 flex flex-col gap-8 desktop:flex-row desktop:items-end desktop:justify-between"
    >
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">Next step</p>
        <h2 class="mt-4 font-display text-[clamp(2rem,5vw,4.5rem)] leading-[1.02]">
          Ready to set sail?
        </h2>
        <p class="mt-6 text-lg text-muted">
          Get in touch to discuss your sailing adventure, charter needs, or upcoming expeditions.
        </p>
      </div>
      <a
        href="/contact"
        class="self-start inline-flex items-center justify-center bg-[color:var(--text)] text-[color:var(--bg)] px-7 py-3.5 text-[11px] font-semibold uppercase font-mono tracking-[0.14em] hover:opacity-85 transition-opacity"
      >
        Book your adventure
      </a>
    </div>
  </section>
</Layout>
